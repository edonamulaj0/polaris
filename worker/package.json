{
  "name": "polaris-worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --config ../wrangler.toml",
    "deploy": "wrangler deploy --config ../wrangler.toml",
    "db:apply": "wrangler d1 execute polaris-db --remote --file=schema.sql --config ../wrangler.toml",
    "db:apply:local": "wrangler d1 execute polaris-db --local --file=schema.sql --config ../wrangler.toml"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "wrangler": "^3.80.0",
    "@cloudflare/workers-types": "^4.20241106.0",
    "typescript": "^5.6.0"
  }
}
