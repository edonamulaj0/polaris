{
  "name": "polaris-worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:apply": "wrangler d1 execute polaris-db --remote --file=schema.sql",
    "db:apply:local": "wrangler d1 execute polaris-db --local --file=schema.sql",
    "db:migrate": "wrangler d1 execute polaris-db --remote --file=migrations/001_topic_submissions.sql",
    "db:migrate:local": "wrangler d1 execute polaris-db --local --file=migrations/001_topic_submissions.sql"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "wrangler": "^3.80.0",
    "@cloudflare/workers-types": "^4.20241106.0",
    "typescript": "^5.6.0"
  }
}
