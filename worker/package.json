{
  "name": "polaris-worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:apply": "wrangler d1 execute polaris-db --remote --file=schema.sql",
    "db:apply:local": "wrangler d1 execute polaris-db --local --file=schema.sql",
    "db:migrate": "wrangler d1 execute polaris-db --remote --file=migrations/001_topic_submissions.sql && wrangler d1 execute polaris-db --remote --file=migrations/002_comments.sql",
    "db:migrate:categories:local": "wrangler d1 execute polaris-db --local --file=migrations/004_expand_categories.sql",
    "db:migrate:curated:local": "wrangler d1 execute polaris-db --local --file=migrations/005_seed_curated_debates.sql",
    "db:migrate:categories": "wrangler d1 execute polaris-db --remote --file=migrations/004_expand_categories.sql",
    "db:migrate:curated": "wrangler d1 execute polaris-db --remote --file=migrations/005_seed_curated_debates.sql",
    "db:migrate:all:local": "npm run db:migrate:local && npm run db:migrate:categories:local && npm run db:migrate:curated:local",
    "db:migrate:comments": "wrangler d1 execute polaris-db --remote --file=migrations/002_comments.sql",
    "db:migrate:comments:local": "wrangler d1 execute polaris-db --local --file=migrations/002_comments.sql",
    "db:migrate:tiers": "wrangler d1 execute polaris-db --remote --file=migrations/003_moderation_tiers.sql",
    "db:migrate:activity": "wrangler d1 execute polaris-db --remote --file=migrations/006_user_activity.sql",
    "db:migrate:activity:local": "wrangler d1 execute polaris-db --local --file=migrations/006_user_activity.sql",
    "db:migrate:editor": "wrangler d1 execute polaris-db --remote --file=migrations/007_editor_auth.sql",
    "db:migrate:editor:local": "wrangler d1 execute polaris-db --local --file=migrations/007_editor_auth.sql",
    "db:migrate:notifications": "wrangler d1 execute polaris-db --remote --file=migrations/008_notifications.sql",
    "db:migrate:notifications:local": "wrangler d1 execute polaris-db --local --file=migrations/008_notifications.sql",
    "db:migrate:subscriptions": "wrangler d1 execute polaris-db --remote --file=migrations/009_debate_subscriptions.sql",
    "db:migrate:subscriptions:local": "wrangler d1 execute polaris-db --local --file=migrations/009_debate_subscriptions.sql"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "wrangler": "^3.80.0",
    "@cloudflare/workers-types": "^4.20241106.0",
    "typescript": "^5.6.0"
  }
}
