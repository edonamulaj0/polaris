# Copy to .env for local dev (never commit .env).
# For production: set the same VITE_* vars in Cloudflare Pages → Settings → Environment variables, then redeploy.

# Google Sign-In — OAuth 2.0 Web client ID (public; safe to expose in the client bundle)
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Optional — dev proxy only (not used in production static builds)
# VITE_NEWS_API_KEY=
